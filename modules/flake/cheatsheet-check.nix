{
  perSystem =
    { pkgs, ... }:
    {
      # Blocks a commit that touches keybind/alias source files (Hyprland,
      # fish, tmux, anivim/mini.nvim, git/jj/lazygit) without also updating
      # modules/aspects/desktop/_files/cheatsheet.html in the same commit.
      # The cheatsheet itself has to be regenerated by asking Claude (the
      # content is synthesized across 5 different config languages, not
      # something a deterministic script can safely extract) - this hook
      # only catches the "forgot to update it" case.
      pre-commit.settings.hooks.cheatsheet-freshness = {
        enable = true;
        name = "cheatsheet freshness check";
        entry = "${pkgs.bash}/bin/bash ${./_files/check-cheatsheet-freshness.sh}";
        language = "system";
        pass_filenames = false;
        always_run = true;
      };
    };
}
