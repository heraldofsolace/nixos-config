{
  config,
  lib,
  modulesPath,
  pkgs,
  ...
}:
{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  # usbhid/usb_storage dropped: root/boot are NVMe-only and there's no
  # interactive initrd prompt (no LUKS, no ZFS keyload) needing a USB
  # keyboard here. Journal traces showed zfs-import-rpool.service's
  # once-a-second poll for rpool's by-partuuid symlink landing in the same
  # window as a burst of USB hub/device enumeration (mouse/keyboard
  # dongles, a webcam, an external optical drive, a Kindle as mass
  # storage) - not binding those device classes during the initrd should
  # ease that contention. xhci_pci/ahci/sd_mod kept: removing the host
  # controller entirely would kill USB rescue-shell access too.
  boot.initrd.availableKernelModules = [
    "nvme"
    "xhci_pci"
    "ahci"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [
    "kvm-amd"
    "uinput"
    "v4l2loopback"
    "coretemp"
    "nct6775"
  ];
  boot.extraModulePackages = [ config.boot.kernelPackages.v4l2loopback ];
  boot.kernelPackages = pkgs.linuxPackages_cachyos;
  boot.zfs.package = pkgs.zfs_cachyos;
  services.scx.enable = true; # by default uses scx_rustland scheduler
  boot.blacklistedKernelModules = [
    "rtl8192cu"
    "rtl_usb"
    "rtl8192c_common"
    "rtlwifi"
  ];
  boot.extraModprobeConfig = ''
    options snd_usb_audio vid=0x1235,0x1235 pid=0x8211,0x8210 device_setup=1,1
  '';
  boot.zfs.extraPools = [ "rpool" ];

  # fileSystems for "/", "/nix", "/home", "/persist", "/boot", "/archive",
  # "/games", the two /boot/efis/* ESP mounts, and swapDevices are
  # generated by disko - see ./_disko.nix. The /boot/efi bind mount below
  # targets a directory (not a block device), so disko has nothing to
  # manage there and it stays hand-written.
  fileSystems."/boot/efi" = {
    device = "/boot/efis/nvme-Seagate_FireCuda_520_SSD_ZP1000GM30002_7QG021QD-part1";
    fsType = "none";
    options = [ "bind" ];
  };

  # disko's zfs_fs dataset type has no neededForBoot option, so this has
  # to be layered on separately - impermanence needs /persist mounted
  # before the regular fileSystems pass.
  fileSystems."/persist".neededForBoot = true;

  hardware.cpu.amd.updateMicrocode = lib.mkDefault true;

  hardware.keyboard.zsa.enable = true;
  hardware.keyboard.qmk.enable = true;
  hardware.logitech.wireless.enable = true;
  hardware.logitech.wireless.enableGraphical = true;
  services.input-remapper.enable = true;
  services.input-remapper.enableUdevRules = true;

  hardware.bluetooth.enable = true;
  services.udev.packages = [ pkgs.bazecor ];
  services.udev.extraRules = ''
    KERNEL=="uinput", MODE="0660", GROUP="uinput", OPTIONS+="static_node=uinput"
  '';
  powerManagement.cpuFreqGovernor = "performance";
}
